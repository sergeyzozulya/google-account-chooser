{
  "manifest_version": 3,
  "name": "Google Account Chooser (and Dashboard)",
  "version": "2.3.1",
  "description": "Redirects Google service links (Gmail, Meet, Calendar, Drive, etc.) through Account Chooser so you can pick the right account.",
  "minimum_chrome_version": "114",
  "permissions": ["webNavigation", "tabs", "tabGroups", "storage", "alarms", "sidePanel", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["history", "bookmarks", "favicon"],
  "host_permissions": [
    "*://accounts.google.com/*",
    "*://mail.google.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "list-accounts", "enabled": true, "path": "rules.json" }]
  },
  "side_panel": {
    "default_path": "popup.html?sidepanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Account Chooser (and Dashboard)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
